; E820 Memory Map Storage Location
; NOTE: Must not overlap with:
;   - Bootloader code (0x7C00 - 0x8C00, ~4KB)
;   - Page table areas (0x9000-0xBFFF)
%define E820_STORAGE_ADDR  0x@E820_STORAGE_ADDR_HEX@  ; Address to store memory map
%define E820_MAX_ENTRIES   @E820_MAX_ENTRIES@       ; Maximum number of E820 entries

; E820 Signature ('SMAP' - ACPI signature)
%define E820_SIGNATURE     'SMAP'

; E820 Memory Types
%define E820_TYPE_USABLE       1    ; Available RAM
%define E820_TYPE_RESERVED     2    ; Reserved, not available
%define E820_TYPE_ACPI_RECLAIM 3    ; ACPI Reclaimable
%define E820_TYPE_NVS          4    ; ACPI NVS Memory
%define E820_TYPE_UNUSABLE     5    ; Unusable memory

; Memory Detection Method (stored at E820_STORAGE_ADDR for kernel)
%define MEM_METHOD_E820       0    ; INT 15h/E820 - Detailed memory map
%define MEM_METHOD_E801       1    ; INT 15h/E801 - Two memory regions
%define MEM_METHOD_88H        2    ; INT 15h/88h - Max 64MB memory
%define MEM_METHOD_UNKNOWN    3    ; No detection method worked

; Memory map entry structure (24 bytes each):
;   Offset 0-7:   Base address (64-bit)
;   Offset 8-15:  Length (64-bit)
;   Offset 16-19: Type (32-bit)
;   Offset 20-23: ACPI attributes (32-bit)
